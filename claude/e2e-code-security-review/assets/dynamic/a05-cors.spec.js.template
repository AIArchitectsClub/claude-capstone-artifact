// OWASP A05:2021 — Security Misconfiguration: CORS.
// A same-origin app must NOT reflect an arbitrary Origin, and must never combine a wildcard/echoed
// origin with credentials. ADAPT: the endpoints probed.

import { test, expect } from "../fixtures.js";
import { hit } from "../helpers/raw.mjs";

const EVIL = "https://evil.example";

test.describe("A05 CORS", () => {
  for (const [method, path, body] of [
    ["GET", "/api/flights", undefined],
    ["POST", "/api/bookings", { flightId: "fl_sec_roomy", quantity: 1 }],
    ["OPTIONS", "/api/bookings", undefined],
  ]) {
    test(`${method} ${path} does not honour a cross-origin request`, async ({ baseURL }) => {
      const r = await hit(baseURL, method, path, {
        origin: EVIL,
        headers: method === "OPTIONS" ? { "access-control-request-method": "POST" } : {},
        body,
      });
      const acao = r.headers["access-control-allow-origin"];
      expect(acao === EVIL, "Origin reflected back").toBe(false);
      expect(acao === "*", "wildcard ACAO").toBe(false);
      if (acao) {
        // if any ACAO is set at all, it must not be paired with credentials
        expect(String(r.headers["access-control-allow-credentials"]).toLowerCase()).not.toBe("true");
      }
    });
  }
});
