// OWASP A05:2021 — Security Misconfiguration: error verbosity, unknown routes, dangerous methods,
// exposed build artifacts.

import { test, expect } from "../fixtures.js";
import { hit, rawMethod } from "../helpers/raw.mjs";
import { LEAK_SIGNATURES, DB_ERROR_SIGNATURES } from "../helpers/payloads.mjs";

test.describe("A05 misconfiguration", () => {
  test("unknown API paths return a JSON 404, not the SPA HTML with a 200", async ({ baseURL }) => {
    const r = await hit(baseURL, "GET", "/api/this-route-does-not-exist-" + Date.now());
    expect(r.status).toBe(404);
    expect(r.contentType).toContain("application/json");
    expect(r.text).not.toContain("<!doctype html");
  });

  test("server errors return a generic message — no stack trace, paths, or SQL", async ({ userA, baseURL }) => {
    // oversized body (limit is 100kb) + a few malformed requests — whatever 4xx/5xx we get,
    // the body must never carry internals.
    const probes = [
      hit(baseURL, "POST", "/api/bookings", { cookie: userA.cookieHeader, headers: { "content-type": "application/json" }, body: "{ not valid json " }),
      hit(baseURL, "POST", "/api/bookings", { cookie: userA.cookieHeader, body: { flightId: { $ne: null }, quantity: { $gt: 0 } } }),
      hit(baseURL, "POST", "/api/bookings", { cookie: userA.cookieHeader, body: "x".repeat(200_000) }),
      hit(baseURL, "GET", "/api/flights?date[]=1&date[]=2"),
    ];
    for (const r of await Promise.all(probes)) {
      for (const sig of [...LEAK_SIGNATURES, ...DB_ERROR_SIGNATURES]) {
        expect(r.text || "", `leaked internals (${sig})`).not.toMatch(sig);
      }
    }
  });

  test("TRACE / TRACK methods are not enabled", async ({ baseURL }) => {
    for (const method of ["TRACE", "TRACK"]) {
      const r = await rawMethod(baseURL, method, "/");
      expect([400, 404, 405, 501], `${method} -> ${r.status}`).toContain(r.status);
      expect(r.text || "", `${method} response echoes the request`).not.toMatch(/TRACE \/ HTTP/i);
    }
  });

  test("no sourcemap files are served from the build", async ({ baseURL, request }) => {
    const html = await (await request.get("/")).text();
    const assets = [...html.matchAll(/(?:src|href)="(\/assets\/[^"]+)"/g)].map((m) => m[1]);
    expect(assets.length).toBeGreaterThan(0);
    for (const a of assets) {
      const map = await hit(baseURL, "GET", a + ".map");
      expect([403, 404], `${a}.map is downloadable`).toContain(map.status);
    }
  });
});
