// OWASP A04:2021 — Insecure Design (business-logic invariants that protect money / capacity).
// ADAPT: the write endpoint, its numeric field, the capacity model.

import { test, expect } from "../fixtures.js";
import { hit } from "../helpers/raw.mjs";
import { count, closePool } from "../helpers/db.mjs";

test.afterAll(() => closePool());

test.describe("A04 insecure design", () => {
  test("quantity is validated — junk and extreme values are rejected with no row written", async ({ userA, baseURL }) => {
    const before = await count("bookings");
    for (const q of [0, -1, -999, 1.5, 1e12, "1 OR 1=1", "abc", null, [], {}]) {
      const r = await hit(baseURL, "POST", "/api/bookings", {
        cookie: userA.cookieHeader,
        body: { flightId: "fl_sec_roomy", quantity: q },
      });
      expect([400, 422], `quantity=${JSON.stringify(q)}`).toContain(r.status);
    }
    expect(await count("bookings"), "an invalid quantity created a row").toBe(before);
  });

  test("capacity cannot be exceeded even via a direct oversized request", async ({ userA, baseURL }) => {
    // fl_sec_small has capacity 2
    const r = await hit(baseURL, "POST", "/api/bookings", {
      cookie: userA.cookieHeader,
      body: { flightId: "fl_sec_small", quantity: 9999 },
    });
    expect([400, 409, 422]).toContain(r.status);
  });

  test("unknown resource id is a 404, missing id is a 400", async ({ userA, baseURL }) => {
    const missing = await hit(baseURL, "POST", "/api/bookings", { cookie: userA.cookieHeader, body: { quantity: 1 } });
    expect(missing.status).toBe(400);
    const unknown = await hit(baseURL, "POST", "/api/bookings", {
      cookie: userA.cookieHeader,
      body: { flightId: "fl_does_not_exist", quantity: 1 },
    });
    expect(unknown.status).toBe(404);
  });
});
