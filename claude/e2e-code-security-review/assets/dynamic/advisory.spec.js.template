// @advisory — reported by `npm run security:advisory`, NOT part of the `npm run security` gate.
// These are hardening opportunities that are either environment-dependent (can't be asserted on
// http://localhost) or a judgement call. Promote one into an enforced spec once the app adopts it.

import { test, expect } from "../fixtures.js";
import { hit } from "../helpers/raw.mjs";

test.describe("advisory hardening @advisory", () => {
  test("session cookie carries the Secure attribute @advisory", async ({ userA }) => {
    // Fails on http://localhost by design — Better Auth only sets Secure when BETTER_AUTH_URL is
    // https. Confirms the production origin is https.
    expect(userA.rawSetCookie.join(" ").toLowerCase()).toContain("secure");
  });

  test("HSTS max-age is at least 6 months and includeSubDomains @advisory", async ({ baseURL }) => {
    const r = await hit(baseURL, "GET", "/");
    const hsts = r.headers["strict-transport-security"] || "";
    const maxAge = Number((hsts.match(/max-age=(\d+)/) || [])[1] || 0);
    expect(maxAge).toBeGreaterThanOrEqual(15_768_000);
    expect(hsts).toMatch(/includeSubDomains/i);
  });

  test("CSP declares a violation report endpoint @advisory", async ({ baseURL }) => {
    const csp = (await hit(baseURL, "GET", "/")).headers["content-security-policy"] || "";
    expect(csp).toMatch(/report-uri|report-to/);
  });

  test("API responses vary on Origin @advisory", async ({ baseURL }) => {
    const r = await hit(baseURL, "GET", "/api/flights");
    expect(String(r.headers["vary"] || "")).toMatch(/origin/i);
  });

  test("cross-origin isolation headers are set @advisory", async ({ baseURL }) => {
    const r = await hit(baseURL, "GET", "/");
    expect(r.headers["cross-origin-opener-policy"]).toBeTruthy();
    expect(r.headers["cross-origin-resource-policy"]).toBeTruthy();
  });
});
