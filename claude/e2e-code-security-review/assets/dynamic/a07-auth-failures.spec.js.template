// OWASP A07:2021 — Identification & Authentication Failures.
// Each test drives its own source IP (X-Forwarded-For, trusted only in the test build) so it
// owns a private Better Auth rate-limit bucket.
// ADAPT: sign-in / sign-up / sign-out paths.

import { test, expect, newUser } from "../fixtures.js";
import { request as pwRequest } from "@playwright/test";
import { hit } from "../helpers/raw.mjs";

const xff = (ip) => ({ "x-forwarded-for": ip });

test.describe("A07 auth failures", () => {
  test("no user enumeration — unknown email and wrong password look identical", async ({ userA, baseURL }) => {
    const ip = xff("198.51.100.11");
    const unknown = await hit(baseURL, "POST", "/api/auth/sign-in/email", {
      headers: ip,
      body: { email: `nobody-${Date.now()}@sec.test`, password: "whatever-123456" },
    });
    const wrongPw = await hit(baseURL, "POST", "/api/auth/sign-in/email", {
      headers: ip,
      body: { email: userA.user.email, password: "definitely-wrong-000" },
    });

    expect(unknown.status).toBe(wrongPw.status);
    expect(unknown.status).toBeGreaterThanOrEqual(400);
    expect(unknown.status).toBeLessThan(500);
    const norm = (s) => (s || "").replace(/[0-9a-f-]{16,}/gi, "X").replace(/\d{10,}/g, "X");
    expect(norm(unknown.text)).toBe(norm(wrongPw.text));
  });

  test("sign-up rejects a weak password", async ({ baseURL }) => {
    const r = await hit(baseURL, "POST", "/api/auth/sign-up/email", {
      headers: xff("198.51.100.22"),
      body: { name: "Weak", email: `weak-${Date.now()}@sec.test`, password: "1234" },
    });
    expect(r.status).toBeGreaterThanOrEqual(400);
    expect(r.status).toBeLessThan(500);
  });

  test("the session is dead after sign-out", async ({ baseURL }) => {
    const u = newUser();
    const ctx = await pwRequest.newContext({
      baseURL,
      extraHTTPHeaders: { origin: baseURL, ...xff("198.51.100.33") },
    });
    const su = await ctx.post("/api/auth/sign-up/email", { data: u });
    expect(su.ok(), `sign-up failed: ${su.status()}`).toBeTruthy();
    const cookie = su
      .headersArray()
      .filter((h) => h.name.toLowerCase() === "set-cookie")
      .map((h) => h.value.split(";")[0])
      .join("; ");

    expect((await hit(baseURL, "GET", "/api/bookings", { cookie })).status).toBe(200);

    const out = await ctx.post("/api/auth/sign-out");
    expect(out.ok(), `sign-out failed: ${out.status()}`).toBeTruthy();

    expect(
      (await hit(baseURL, "GET", "/api/bookings", { cookie })).status,
      "the pre-sign-out session token still authorizes requests",
    ).toBe(401);
    await ctx.dispose();
  });

  test("login is rate limited", async ({ baseURL }) => {
    const email = `ratelimit-${Date.now()}@sec.test`;
    const statuses = [];
    for (let i = 0; i < 8; i++) {
      const r = await hit(baseURL, "POST", "/api/auth/sign-in/email", {
        headers: xff("198.51.100.44"),
        body: { email, password: "nope-000000" },
      });
      statuses.push(r.status);
    }
    expect(statuses, `expected a 429 in ${JSON.stringify(statuses)}`).toContain(429);
  });
});
