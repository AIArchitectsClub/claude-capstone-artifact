// Low-level HTTP helper for header/status assertions — no redirect following, returns everything.
// Uses Node's fetch so we see exactly what the server sent (Playwright's APIRequestContext also
// works, but this keeps header casing and multi-value headers explicit).

export async function hit(baseURL, method, path, opts = {}) {
  const headers = { ...(opts.headers || {}) };
  let body = opts.body;
  if (body !== undefined && typeof body !== "string") {
    headers["content-type"] = headers["content-type"] || "application/json";
    body = JSON.stringify(body);
  }
  if (opts.cookie) headers.cookie = opts.cookie;
  if (opts.origin) headers.origin = opts.origin;

  const res = await fetch(new URL(path, baseURL), { method, headers, body, redirect: "manual" });
  const text = await res.text();
  let json;
  try {
    json = JSON.parse(text);
  } catch {
    /* not json */
  }
  const h = {};
  for (const [k, v] of res.headers) h[k.toLowerCase()] = v;
  return {
    status: res.status,
    headers: h,
    setCookie: res.headers.getSetCookie ? res.headers.getSetCookie() : [],
    text,
    json,
    contentType: h["content-type"] || "",
  };
}

/**
 * Send a request with a method the Fetch spec forbids (TRACE, TRACK, CONNECT) using node:http,
 * which has no such restriction. Returns { status, headers, text }.
 */
export async function rawMethod(baseURL, method, path) {
  const { request: httpRequest } = await import("node:http");
  const u = new URL(path, baseURL);
  return new Promise((resolve, reject) => {
    const req = httpRequest(
      { method, hostname: u.hostname, port: u.port, path: u.pathname + u.search },
      (res) => {
        let text = "";
        res.on("data", (c) => (text += c));
        res.on("end", () => resolve({ status: res.statusCode, headers: res.headers, text }));
      },
    );
    req.on("error", reject);
    req.end();
  });
}

/** Pull `name=value` for the session cookie out of a Set-Cookie array. */
export function sessionCookie(setCookieArray) {
  for (const c of setCookieArray || []) {
    const first = c.split(";")[0].trim();
    if (/session|auth|sid|connect\.sid/i.test(first)) return first;
  }
  return (setCookieArray?.[0] || "").split(";")[0].trim() || null;
}
