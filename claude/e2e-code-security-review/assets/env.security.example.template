# security/.env.security  — copy to `.env.security` (gitignored) and fill in.
#
# ⚠️  The dynamic security suite migrates + seeds this database and fires injection payloads at
#     it. It must be a SEPARATE, throwaway database — never the app's own DB. global-setup.js
#     hard-fails if this resolves to the same database as the app's .env DATABASE_URL.

TEST_DATABASE_URL=

# Port the (production-mode) app instance under test listens on. Must be free and not the app's
# normal dev port or the e2e suite's port.
SECURITY_TEST_PORT=3998

# Any 32+ char secret, scoped to the test instance only.
SECURITY_BETTER_AUTH_SECRET=security_only_secret_change_me_0123456789abcdef

# Optional: gate severity for the static scanner (critical|high|medium|low). Default: medium.
# SECURITY_GATE=medium
# Optional: npm audit level that fails the build (critical|high|moderate|low). Default: high.
# SECURITY_AUDIT_LEVEL=high
