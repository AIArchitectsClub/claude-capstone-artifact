// The read-heavy, unauthenticated scenario the "TPS" and "Peak Load" NFRs
// are measured against. Rewrite the endpoints for a different app's actual
// core read path (this reference app: browse/search + per-item pricing).
import http from 'k6/http';
import { check, group } from 'k6';
import { apiUrl } from '../lib/http-client.js';

function isoDate(daysFromNow) {
  return new Date(Date.now() + daysFromNow * 86400000).toISOString().slice(0, 10);
}

export function browseAndPrice() {
  group('browse_and_price', () => {
    const listRes = http.get(apiUrl('/api/cars'), { tags: { name: 'GET /api/cars' } });
    const listOk = check(listRes, { 'list cars: 200': (r) => r.status === 200 });
    if (!listOk) return;

    const cars = listRes.json();
    if (!cars.length) return;
    const car = cars[Math.floor(Math.random() * cars.length)];

    http.get(apiUrl(`/api/cars/${car.id}`), { tags: { name: 'GET /api/cars/:id' } });

    const offset = 3 + Math.floor(Math.random() * 120);
    const span = 1 + Math.floor(Math.random() * 4);
    const start = isoDate(offset);
    const end = isoDate(offset + span);

    http.get(apiUrl(`/api/cars/${car.id}/pricing?start=${start}&end=${end}`), {
      tags: { name: 'GET /api/cars/:id/pricing' },
    });
    http.get(apiUrl(`/api/cars/${car.id}/bookings`), { tags: { name: 'GET /api/cars/:id/bookings' } });
  });
}

