// Generated by the e2e-perfromance-test-suite-k6 skill.
// The full-transaction scenario the "Concurrent Users" and "TAT" NFRs are
// measured against: register -> login -> browse -> price -> book -> view
// -> cancel. Rewrite the steps/payload fields for a different app's actual
// primary transaction — this reference app is a car-rental booking flow;
// keep the group/metric names ('booking_lifecycle_tat_ms',
// 'booking_lifecycle' group) if you want lib/scenarios.js's thresholds to
// keep working unmodified, or update both together.
import http from 'k6/http';
import { check, group, sleep } from 'k6';
import { Trend, Rate } from 'k6/metrics';
import { apiUrl, authHeaders, jsonHeaders, formHeaders } from '../lib/http-client.js';

export const tatTrend = new Trend('booking_lifecycle_tat_ms', true);
export const bookingConflictRate = new Rate('booking_conflict_rate');

function isoDate(daysFromNow) {
  return new Date(Date.now() + daysFromNow * 86400000).toISOString().slice(0, 10);
}

function uniqueIdentity() {
  const suffix = `${__VU}-${__ITER}-${Date.now()}`;
  return {
    email: `k6-loadtest-${suffix}@example.com`,
    password: 'LoadTest!2345',
    name: `K6 Load Tester ${suffix}`,
  };
}

export function bookingLifecycle() {
  const startedAt = Date.now();

  group('booking_lifecycle', () => {
    const { email, password, name } = uniqueIdentity();
    let token;

    group('register', () => {
      const res = http.post(
        apiUrl('/api/auth/register'),
        JSON.stringify({ name, email, password }),
        jsonHeaders(),
      );
      const ok = check(res, { 'register: 201': (r) => r.status === 201 });
      if (ok) token = res.json('access_token');
    });

    if (!token) {
      // Registration failing under load is itself a real signal — don't mask
      // it by trying to continue with an unauthenticated session.
      group('login_fallback', () => {
        const res = http.post(
          apiUrl('/api/auth/token'),
          `username=${encodeURIComponent(email)}&password=${encodeURIComponent(password)}`,
          formHeaders(),
        );
        if (check(res, { 'login: 200': (r) => r.status === 200 })) {
          token = res.json('access_token');
        }
      });
    }

    if (!token) return; // no point continuing an authenticated flow without one

    let carId;
    group('browse_cars', () => {
      const res = http.get(apiUrl('/api/cars'), authHeaders(token));
      const ok = check(res, {
        'list cars: 200': (r) => r.status === 200,
        'list cars: non-empty': (r) => r.status === 200 && r.json().length > 0,
      });
      if (ok) {
        const cars = res.json();
        carId = cars[Math.floor(Math.random() * cars.length)].id;
      }
    });

    if (!carId) return;

    // Wide, randomized date window: keeps some natural booking contention
    // without every VU deterministically colliding on the same dates (see
    // references/k6-conventions.md).
    const offset = 3 + Math.floor(Math.random() * 150);
    const span = 1 + Math.floor(Math.random() * 4);
    const startDate = isoDate(offset);
    const endDate = isoDate(offset + span);

    group('check_pricing', () => {
      const res = http.get(
        apiUrl(`/api/cars/${carId}/pricing?start=${startDate}&end=${endDate}`),
        authHeaders(token),
      );
      check(res, { 'pricing: 200': (r) => r.status === 200 });
    });

    let bookingId;
    group('create_booking', () => {
      const res = http.post(
        apiUrl('/api/bookings'),
        JSON.stringify({
          carId,
          driverName: name,
          email,
          phone: '9999999999',
          pickupLocation: 'Airport Terminal 1',
          startDate,
          endDate,
          paymentMethod: 'card',
        }),
        authHeaders(token),
      );
      const isConflict = res.status === 409;
      bookingConflictRate.add(isConflict);
      const ok = check(res, {
        'booking: 201 or expected 409 conflict': (r) => r.status === 201 || r.status === 409,
      });
      if (ok && res.status === 201) bookingId = res.json('id');
    });

    if (bookingId) {
      group('view_my_bookings', () => {
        const res = http.get(apiUrl('/api/bookings/me'), authHeaders(token));
        check(res, { 'my bookings: 200': (r) => r.status === 200 });
      });

      group('cancel_booking', () => {
        const res = http.post(apiUrl(`/api/bookings/${bookingId}/cancel`), null, authHeaders(token));
        check(res, { 'cancel: 200': (r) => r.status === 200 });
      });
    }
  });

  tatTrend.add(Date.now() - startedAt);
  sleep(1); // think-time between a simulated user's sessions
}

// Allows `k6 run tests/booking-lifecycle.js` standalone for a quick,
// unparameterized check of just this flow (fixed light load — the full NFR
// profile always runs through tests/load-test.js instead).
export const options = {
  scenarios: {
    standalone: { executor: 'shared-iterations', vus: 5, iterations: 20, exec: 'bookingLifecycle' },
  },
  thresholds: {
    http_req_failed: ['rate<0.05'],
  },
};
