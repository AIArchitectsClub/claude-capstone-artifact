// OWASP A02:2021 — Cryptographic Failures  +  A05 sensitive-data-in-response.
// ADAPT: the endpoint sweep list, the session-endpoint path.

import { test, expect } from "../fixtures.js";
import { hit } from "../helpers/raw.mjs";

test.describe("A02 crypto & sensitive data", () => {
  test("session cookie is HttpOnly and SameSite", async ({ userA }) => {
    const cookie = userA.rawSetCookie.join(" ; ").toLowerCase();
    expect(cookie).toContain("httponly");
    expect(cookie).toMatch(/samesite=(lax|strict)/);
  });

  test("no API response leaks a password, the auth secret, or a DB URL", async ({ userA, anon, seeded, baseURL }) => {
    const secret = seeded.authSecret;
    const probes = [
      ["GET", "/api/flights", null],
      ["GET", `/api/flights/${seeded.flights[0].id}`, null],
      ["GET", "/api/chat/config", null],
      ["GET", "/api/bookings", userA.cookieHeader],
      ["GET", "/api/auth/get-session", userA.cookieHeader],
      ["POST", "/api/bookings", userA.cookieHeader], // 400 path
    ];
    for (const [method, path, cookie] of probes) {
      const r = await hit(baseURL, method, path, { cookie, body: method === "POST" ? {} : undefined });
      const body = r.text || "";
      expect(body, `${path} leaks "password"`).not.toMatch(/"(password|passwordHash|hashedPassword|hash)"\s*:/i);
      expect(body, `${path} leaks a bcrypt/argon hash`).not.toMatch(/\$2[aby]\$\d\d\$|\$argon2/);
      if (secret) expect(body, `${path} leaks the auth secret`).not.toContain(secret);
      expect(body, `${path} leaks a DB connection string`).not.toMatch(/postgres(ql)?:\/\/[^\s"]+:[^\s"]+@/);
    }
  });

  test("get-session returns only the caller and no password field", async ({ userA, userB, baseURL }) => {
    const r = await hit(baseURL, "GET", "/api/auth/get-session", { cookie: userA.cookieHeader });
    expect(r.status).toBe(200);
    const s = JSON.stringify(r.json || {});
    expect(s).toContain(userA.user.email);
    expect(s).not.toContain(userB.user.email);
    expect(s.toLowerCase()).not.toMatch(/"password"|"hashedpassword"/);
  });

  test("API responses are not cacheable (Cache-Control: no-store)", async ({ userA, baseURL }) => {
    for (const path of ["/api/flights", "/api/bookings"]) {
      const r = await hit(baseURL, "GET", path, { cookie: userA.cookieHeader });
      expect(r.headers["cache-control"] || "", path).toMatch(/no-store/);
    }
  });
});
