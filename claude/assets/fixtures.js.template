// Fixtures for the dynamic security suite.
//
//   seeded   — parsed security/.seed-manifest.json (lazy).
//   anon     — an unauthenticated APIRequestContext (fresh cookie jar).
//   userA /  — WORKER-scoped. Each is signed up once via the sign-up API (which sets the session
//   userB      cookie); exposes { user, id, ctx (authed APIRequestContext), cookieHeader,
//              rawSetCookie }. Worker scope keeps total sign-ups tiny so the auth rate-limit
//              bucket isn't a problem for other specs.

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { test as base, request as pwRequest, expect } from "@playwright/test";
import { sessionCookie } from "./helpers/raw.mjs";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const MANIFEST = path.join(__dirname, ".seed-manifest.json");

function readManifest() {
  if (!fs.existsSync(MANIFEST)) {
    throw new Error("[security] .seed-manifest.json missing — run via `npm run security:dynamic`");
  }
  return JSON.parse(fs.readFileSync(MANIFEST, "utf8"));
}

let counter = 0;
export function newUser() {
  counter += 1;
  const tag = `${Date.now().toString(36)}-${counter}`;
  return { name: `Sec User ${tag}`, email: `sec+${tag}@sec.test`, password: "sec-Password-123" };
}

// Distinct source IP per actor -> distinct Better Auth rate-limit bucket (the test build trusts
// X-Forwarded-For). Keeps fixture sign-ups from tripping the 3-per-10s auth limit.
export function fakeIp() {
  counter += 1;
  return `10.${(counter >> 8) & 255}.${counter & 255}.${1 + (Math.random() * 250) | 0}`;
}

async function makeUser(baseURL) {
  const user = newUser();
  // origin: browsers always send it, and Better Auth rejects cookie-bearing state-changing
  // requests that lack a trusted Origin (its CSRF guard). x-forwarded-for: own rate-limit bucket.
  const ctx = await pwRequest.newContext({
    baseURL,
    extraHTTPHeaders: { origin: baseURL, "x-forwarded-for": fakeIp() },
  });
  const res = await ctx.post("/api/auth/sign-up/email", { data: user });
  if (!res.ok()) throw new Error(`[security] sign-up failed ${res.status()}: ${await res.text()}`);
  const rawSetCookie = res
    .headersArray()
    .filter((h) => h.name.toLowerCase() === "set-cookie")
    .map((h) => h.value);
  const body = await res.json().catch(() => ({}));
  return {
    user,
    id: body?.user?.id ?? null,
    ctx,
    rawSetCookie,
    cookieHeader: sessionCookie(rawSetCookie),
  };
}

export const test = base.extend({
  seeded: [async ({}, use) => { await use(readManifest()); }, { scope: "test" }],

  anon: [
    async ({ baseURL }, use) => {
      const ctx = await pwRequest.newContext({ baseURL, extraHTTPHeaders: { "x-forwarded-for": fakeIp() } });
      await use(ctx);
      await ctx.dispose();
    },
    { scope: "test" },
  ],

  // Worker-scoped: signed up once per run. Worker fixtures can't read the `baseURL` test option,
  // so they take it from the seed manifest that global-setup wrote.
  userA: [
    async ({}, use) => {
      const u = await makeUser(readManifest().baseUrl);
      await use(u);
      await u.ctx.dispose();
    },
    { scope: "worker" },
  ],

  userB: [
    async ({}, use) => {
      const u = await makeUser(readManifest().baseUrl);
      await use(u);
      await u.ctx.dispose();
    },
    { scope: "worker" },
  ],
});

export { expect };
export const wait = (ms) => new Promise((r) => setTimeout(r, ms));
