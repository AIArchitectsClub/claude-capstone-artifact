// Minimal deterministic dataset for the dynamic security suite. global-setup inserts these and
// records the resolved rows in security/.seed-manifest.json for the specs.

function atUTC(daysFromNow, hour) {
  const d = new Date();
  d.setUTCDate(d.getUTCDate() + daysFromNow);
  d.setUTCHours(hour, 0, 0, 0);
  return d.toISOString();
}

export function buildSeedFlights() {
  return [
    {
      id: "fl_sec_roomy",
      flightNumber: "SEC100", airline: "Aurora Air", aircraftType: "Airbus A320",
      origin: "JFK", originCity: "New York", destination: "LAX", destinationCity: "Los Angeles",
      departureAt: atUTC(4, 9), arrivalAt: atUTC(4, 15), capacity: 180, priceAmount: 200,
    },
    {
      id: "fl_sec_small",
      flightNumber: "SEC200", airline: "Skyline Express", aircraftType: "Boeing 737-800",
      origin: "SFO", originCity: "San Francisco", destination: "SEA", destinationCity: "Seattle",
      departureAt: atUTC(4, 14), arrivalAt: atUTC(4, 17), capacity: 2, priceAmount: 150,
    },
  ];
}
