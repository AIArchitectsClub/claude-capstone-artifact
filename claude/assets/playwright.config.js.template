import path from "node:path";
import { fileURLToPath } from "node:url";
import { defineConfig, devices } from "@playwright/test";
import { config as loadEnv } from "dotenv";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const APP_ROOT = path.join(__dirname, "..");

loadEnv({ path: path.join(__dirname, ".env.security") });

if (!process.env.TEST_DATABASE_URL) {
  throw new Error(
    "TEST_DATABASE_URL is not set.\n" +
      "  cp security/.env.security.example security/.env.security  and point it at a SEPARATE\n" +
      "  throwaway database — this suite migrates, seeds and fires injection payloads at it.",
  );
}

const PORT = process.env.SECURITY_TEST_PORT || "3998";
const BASE_URL = `http://localhost:${PORT}`;
const AUTH_SECRET =
  process.env.SECURITY_BETTER_AUTH_SECRET || "security_only_secret_change_me_0123456789abcdef";

export default defineConfig({
  testDir: path.join(__dirname, "dynamic"),
  outputDir: path.join(__dirname, "test-results"),

  fullyParallel: false,
  workers: 1, // shared DB + a global auth rate-limit bucket — must be serial
  retries: 0,
  timeout: 60_000,
  expect: { timeout: 10_000 },

  reporter: [
    ["list"],
    ["html", { outputFolder: path.join(__dirname, "playwright-report"), open: "never" }],
  ],

  globalSetup: path.join(__dirname, "global-setup.js"),

  use: {
    baseURL: BASE_URL,
    trace: "retain-on-failure",
    screenshot: "only-on-failure",
  },

  projects: [{ name: "chromium", use: { ...devices["Desktop Chrome"] } }],

  // The suite tests the PRODUCTION build: `npm run start` sets NODE_ENV=production and serves
  // dist/ (built in global-setup). dotenv in the app won't override these already-set vars.
  webServer: {
    command: "npm run start",
    cwd: APP_ROOT,
    url: BASE_URL,
    reuseExistingServer: false,
    timeout: 120_000,
    stdout: "pipe",
    stderr: "pipe",
    env: {
      DATABASE_URL: process.env.TEST_DATABASE_URL,
      PORT: String(PORT),
      BETTER_AUTH_SECRET: AUTH_SECRET,
      BETTER_AUTH_URL: BASE_URL,
      // Make Better Auth rate-limit per-client so each test actor (its own X-Forwarded-For) gets
      // its own bucket — and the rate-limit spec can target one bucket deterministically.
      TRUSTED_IP_HEADER: "x-forwarded-for",
    },
  },
});
